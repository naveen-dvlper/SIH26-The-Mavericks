# Google Gemini API Key for civic issue AI analysis & ranking (Server-side)
GEMINI_API_KEY=

# MongoDB Connection String (Leave blank or 127.0.0.1 to use built-in In-Memory MongoDB)
MONGODB_URI=

# Optional: Production Backend API URL for client-side builds (e.g. on Netlify or Vercel)
# Example: VITE_BACKEND_URL=https://sih26-the-mavericks.onrender.com
# If left empty in local dev or unified container, relative requests (/api/...) are used.
VITE_BACKEND_URL=
